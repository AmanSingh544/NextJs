const simulateDelay = (ms) => new Promise(res => setTimeout(res, ms)); 

export async function saveTodo(todos){
    await simulateDelay(500); // Simulate a delay of 500ms
    await fs.writeFile(filePath, JSON.stringify(todos, null, 2));
}

export async function deleteTodo(id){
    const todos = await getTodos();
    await saveTodo(await todos.filter(todo => todo.id !== id));
}

export async function toogleTodo(id){
    const todos = await getTodos();
    const todo = todos.find(todo => todo.id === id);
    if (todo) {
        todo.completed = !todo.completed;
        await saveTodo(todos);
    }
}

export async function updateTodo(id, newText){
    const todos = await getTodos();
    const updatedTodos = todos.map(todo => todo.id === id ? {...todo, text: newText} : todo);
    await saveTodo(updatedTodos);
}
